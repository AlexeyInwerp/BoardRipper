# BoardRipper Web (lite build) — app-scoped overrides for ripperdoc.de/boardripper/web.
# Deployed to /public_html/boardripper/web/.htaccess by scripts/deploy-lite.sh.
#
# ripperdoc.de runs LiteSpeed with a strict site-wide CSP + `X-Content-Type-Options:
# nosniff` (RipperDocWeb/public/.htaccess). Without the overrides below the lite SPA
# breaks in three ways — all confirmed against the live server:
#   1. the pdf.js worker (.mjs) is rejected under `nosniff` unless its MIME is a JS
#      type (LiteSpeed does not map .mjs by default);
#   2. PixiJS needed `unsafe-eval` to initialise its renderer — no longer:
#      main.tsx imports `pixi.js/unsafe-eval` (eval-free uniform parsers), so
#      'unsafe-eval' was dropped from script-src on 2026-09-04. Verified by
#      opening a board under this exact header. 'wasm-unsafe-eval' stays for
#      pdf.js's wasm decoders;
#   3. Web Workers, wasm, blob: URLs and the FZ-key cross-origin fetch are blocked
#      by the site CSP (default-src 'self', connect-src 'self').
# This directory serves the user's own local-only viewer, so it gets an app-
# appropriate policy scoped here only. Nothing outside /boardripper/web/ changes.

# --- Correct MIME types (nosniff means these MUST be exact) ---
AddType text/javascript .js
AddType text/javascript .mjs
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType application/wasm .wasm

<IfModule mod_headers.c>
  # Replace the inherited restrictive CSP with one this app needs.
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob: https://raw.githubusercontent.com https://*.githubusercontent.com; manifest-src 'self'; object-src 'none'; base-uri 'self'"
</IfModule>

# --- Service-worker freshness ---
# The site-wide rule marks every .js `immutable` for a year. That is right for
# the hashed bundles and WRONG for the three files whose whole job is to change
# under a stable name: browsers cap SW-script freshness at 24 h regardless, so
# an installed PWA could lag a deploy by a day. (Measured live 2026-09-04:
# sw.js came back `max-age=31536000, immutable`.) index.html is already
# no-cache; these must match it.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
