# ripperdoc-devicedb deploy credentials
#
# Copy this file to `.env` (gitignored) and fill in real values.
# `scripts/deploy.sh` auto-loads .env on every run.
#
# Required for `scripts/deploy.sh`:
DEVICEDB_FTP_HOST=ftp.ripperdoc.de
DEVICEDB_FTP_USER=ftp@ripperdoc.de
DEVICEDB_FTP_PASS=put-real-password-here

# Optional — defaults to /public_html/devicedb if unset.
# Use a staging path for first push, then re-deploy to the canonical
# path after smoke-testing:
#   DEVICEDB_REMOTE_PATH=/public_html/devicedb-staging
#
DEVICEDB_REMOTE_PATH=/public_html/devicedb
