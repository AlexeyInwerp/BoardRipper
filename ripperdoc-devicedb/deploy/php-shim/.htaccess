# ripperdoc-devicedb shim .htaccess
#
# Drop this file alongside index.php into  /public_html/devicedb/  on the
# website's host. Also copy the static frontend (../../web/*.html) into
# the same /public_html/devicedb/  so Apache can serve them directly.
#
# Strategy:
#   - Static .html / .css / .js / .svg / images → served directly by Apache
#     (no PHP round-trip).
#   - /devicedb/api/v1/*  → routed through the PHP shim which forwards to
#     the NAS Go service.
#   - /devicedb/ root     → serves index.html (DirectoryIndex).

RewriteEngine On
RewriteBase /devicedb/

# Never let the shim service its own source.
RewriteRule ^index\.php$ - [L]
RewriteRule ^\.htaccess$ - [F,L]

# If the requested path is a real static file (index.html, register.html,
# recent.html, anything we copied alongside), serve it directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule .* - [L]

# Otherwise route through the PHP shim. This catches /api/v1/*, and also
# any client-side links the static pages might emit (e.g. board detail
# deep-links).
RewriteRule ^(.*)$ index.php/$1 [L,QSA]

DirectoryIndex index.html

# Don't leak upstream errors via PHP display_errors.
php_flag display_errors off

# CORS for the API surface — read responses go through the shim's
# CORS header, but browsers also issue OPTIONS preflights to the
# static-served paths in some configurations. Mirror what the Go
# server sets.
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>
